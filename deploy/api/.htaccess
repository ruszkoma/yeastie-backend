# https://yeastie.cprojekt.pl/api/ -> index.php (the application itself lives outside the docroot).
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
	RewriteEngine On

	# LiteSpeed and Apache with CGI drop the Authorization header unless it is passed on explicitly.
	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	# The API is HTTPS only (directly or behind a TLS proxy). No redirect: a redirected POST would
	# lose its body.
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https
	RewriteRule ^ - [F]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
	ErrorDocument 404 index.php
</IfModule>

