#--------------------------------------------------------------------
# Copy to `.env` next to `app/` (never inside the public directory) and fill in.
# `.env` is not in git. Do not paste its values into chats or tickets.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://yeastie.cprojekt.pl/api/'

# Database user of the API. With a separate migrations user below it needs only
# SELECT, INSERT, UPDATE, DELETE; with one user it needs all privileges on the database.
database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =

# Optional migrations user (also CREATE, ALTER, DROP, INDEX, REFERENCES), used by
# `php spark yeastie:migrate`. Without these lines migrations use the user above.
# database.migrations.hostname = localhost
# database.migrations.database =
# database.migrations.username =
# database.migrations.password =

yeastie.firebaseProjectId = yeastie-99dca
yeastie.serviceAccountFile = /home/<account>/yeastie_api/secrets/service-account.json
yeastie.playPackageName = pl.cprojekt.yeastie
yeastie.premiumProductId = premium
yeastie.pubsubAudience = https://yeastie.cprojekt.pl/api/v1/rtdn
yeastie.pubsubServiceAccountEmail =
